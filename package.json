{
  "name": "kropla-w-polu",
  "private": true,
  "version": "0.1.0",
  "description": "Kropla w Polu – asystent gospodarowania wodą na działce rolnej (HackNation 2026, wyzwanie KOWR)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "preview": "vite preview",
    "start": "tsx server/standalone.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
